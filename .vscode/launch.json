{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Dev: native",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build",
      "program": "${workspaceFolder}/bin/PowerLinesDataService/Debug/net10.0/PowerLinesDataService.dll",
      "cwd": "${workspaceFolder}/PowerLinesDataService",
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "integratedTerminal",
      "args": [
        "--fixtures"
      ]
    },
    {
      "name": "Docker: Attach",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickRemoteProcess}",
      "pipeTransport": {
        "pipeProgram": "docker",
        "pipeArgs": [
          "exec",
          "-i",
          "${input:importContainer}"
        ],
        "debuggerPath": "/vsdbg/vsdbg",
        "quoteArgs": false
      },
      "sourceFileMap": {
        "/home/dotnet": "${workspaceFolder}"
      }
    }
  ],
  "inputs": [
    {
      "id": "importContainer",
      "type": "promptString",
      "description": "Running disposable importer container name or ID (docker ps)",
      "default": "power-lines-data-service"
    }
  ]
}
