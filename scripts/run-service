#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
if [[ "${1:-}" == --docker ]]; then
  shift
  ./scripts/services-up
  exec docker compose --profile app run --build --rm --no-deps power-lines-data-service "$@"
fi
export DOTNET_ENVIRONMENT="${DOTNET_ENVIRONMENT:-Development}"
exec dotnet run --project PowerLinesDataService --no-launch-profile -- "$@"
